# Copy this file to backend/.env, then replace the sample values.
# Never commit .env or real credentials.

# Backend and frontend origins
PORT=5000
CLIENT_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:5000

# MySQL: product/order features also require the business schema and data.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=televaga_demo

# Telegram: replace with your own BotFather token for a single environment bot.
# Local polling needs no public HTTPS URL. Remove any existing webhook first.
TELEGRAM_BOT_TOKEN=replace_with_a_new_token_from_botfather
TELEGRAM_MODE=polling
# Alternatively, leave TELEGRAM_BOT_TOKEN empty and set TELEGRAM_MODE=mock,
# then add and enable bots through the Bot Management screen.

# Optional: for the environment bot webhook endpoint; not needed for polling.
TELEGRAM_WEBHOOK_SECRET=

# Optional stable encryption key for saved managed-bot tokens.
# Set your own secret before saving bots and keep it unchanged afterwards.
# Empty: the backend creates data/bot-token.key; back up that file with the DB.
BOT_TOKEN_ENCRYPTION_KEY=

# Optional Gemini API key. Empty or failed API calls use local fallback responses.
GEMINI_API_KEY=
# Override with a model available to your API account if needed.
# GEMINI_MODEL=your_available_model_id

# Optional legacy mock flag; normally leave unset to use the configured default.
# MOCK_MODE=false

# Admin login (change password before public deployment)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456
# For separate frontend/backend sites over HTTPS: secure=true, same_site=none
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Managed MySQL / deployment (local defaults remain unchanged)
DB_SSL=false
# PEM CA certificate; literal \n is supported
DB_SSL_CA=
DB_AUTO_CREATE=true
DB_REQUIRED=false
BNK_REQUIRED=false
